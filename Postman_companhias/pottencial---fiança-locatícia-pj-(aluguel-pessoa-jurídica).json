{
  "openapi": "3.0.3",
  "info": {
    "title": "Pottencial - Fiança Locatícia PJ (Aluguel Pessoa Jurídica)",
    "description": "API para cotação, reanálise, proposta e emissão de apólices do produto Fiança Locatícia (Aluguel) para Pessoa Jurídica — Plano Tradicional.",
    "version": "1.0.0",
    "contact": {
      "name": "Pottencial Seguradora",
      "url": "https://pottencial.com.br/fale-conosco/"
    }
  },
  "servers": [
    {
      "url": "https://api-hml.pottencial.com.br",
      "description": "Homologação"
    },
    {
      "url": "https://api.pottencial.com.br",
      "description": "Produção"
    }
  ],
  "security": [
    {
      "clientId": []
    },
    {
      "accessToken": []
    }
  ],
  "tags": [
    {
      "name": "Cotação",
      "description": "Operações de cotação PJ"
    },
    {
      "name": "Proposta PJ",
      "description": "Operações de proposta e apólice PJ"
    }
  ],
  "paths": {
    "/partners/rentalbond/v1/Quotes": {
      "post": {
        "summary": "Criar cotação",
        "description": "Cria uma nova cotação para Fiança Locatícia PJ — Plano Tradicional. O processamento é assíncrono: a resposta retorna um `id` (requestId) e o resultado é enviado para a `callbackUrl`.\n",
        "operationId": "createQuotePj",
        "tags": [
          "Cotação"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/personId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cotação aceita para processamento assíncrono",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteCreatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado"
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    },
    "/partners/rentalbond/v1/Quotes/{quote_id}": {
      "get": {
        "summary": "Consultar cotação",
        "description": "Retorna os dados completos de uma cotação PJ pelo seu identificador, incluindo status, coberturas e limites disponíveis.\n",
        "operationId": "getQuotePj",
        "tags": [
          "Cotação"
        ],
        "parameters": [
          {
            "name": "quote_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador da cotação (requestId retornado na criação)."
          }
        ],
        "responses": {
          "200": {
            "description": "Cotação localizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                }
              }
            }
          },
          "404": {
            "description": "Cotação não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno"
          }
        }
      },
      "put": {
        "summary": "Atualizar cotação",
        "description": "Atualiza os dados de uma cotação PJ existente. Só é possível atualizar enquanto a proposta/apólice não tiver sido emitida.\n",
        "operationId": "updateQuotePj",
        "tags": [
          "Cotação"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/personId"
          },
          {
            "name": "quote_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador da cotação a ser atualizada."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cotação atualizada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    },
    "/partners/rentalbond/v1/Quotes/{quote_id}/pdf": {
      "get": {
        "summary": "Consultar documento da cotação (PDF)",
        "description": "Retorna o PDF da cotação em Base64. Disponível somente para cotações com status `Approved`.",
        "operationId": "getQuotePdfPj",
        "tags": [
          "Cotação"
        ],
        "parameters": [
          {
            "name": "quote_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador da cotação."
          }
        ],
        "responses": {
          "200": {
            "description": "PDF gerado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PdfResponse"
                }
              }
            }
          },
          "400": {
            "description": "Cotação em status não permitido para geração do PDF",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Cotação não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    },
    "/partners/rentalbond/v1/Policy/Subscription": {
      "get": {
        "summary": "Consultar carta de aprovação/recusa",
        "description": "Retorna a carta de análise (aprovação ou recusa) da cotação PJ em PDF (Base64). Disponível para cotações com status `Approved` (carta de aprovação) ou `Refused` (carta de recusa).\n",
        "operationId": "getSubscriptionLetterPj",
        "tags": [
          "Cotação"
        ],
        "parameters": [
          {
            "name": "requestId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador da cotação (requestId retornado na criação)."
          }
        ],
        "responses": {
          "200": {
            "description": "Carta gerada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PdfResponse"
                }
              }
            }
          },
          "400": {
            "description": "RequestId inválido, tipo de locatário inválido ou cotação em status não permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Cotação não encontrada ou PDF vazio retornado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    },
    "/partners/rentalbond/v1/Quotes/reanalysis/{quote_id}": {
      "put": {
        "summary": "Solicitar reanálise",
        "description": "Solicita a reanálise de uma cotação PJ junto à Mesa de Subscrição. O processamento é assíncrono e o resultado é enviado para a `callbackUrl`. Os arquivos de suporte são enviados como Base64 no corpo JSON.\n",
        "operationId": "requestReanalysisPj",
        "tags": [
          "Cotação"
        ],
        "parameters": [
          {
            "name": "quote_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador da cotação a ser reanalisada."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteReanalysisRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reanálise solicitada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteCreatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos, cotação inelegível ou arquivos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    },
    "/partners/rentalbond/v1/Quotes/{quote_id}/draft": {
      "get": {
        "summary": "Baixar documento de minuta",
        "description": "Retorna a minuta da cotação em formato PDF (Base64).",
        "operationId": "getQuoteDraftPj",
        "tags": [
          "Cotação"
        ],
        "parameters": [
          {
            "name": "quote_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador da cotação."
          }
        ],
        "responses": {
          "200": {
            "description": "Minuta retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PdfResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado"
          },
          "404": {
            "description": "Cotação não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    },
    "/partners/rentalbond/v1/Quotes/{quote_id}/payment-simulation": {
      "get": {
        "summary": "Consultar condições de pagamento",
        "description": "Retorna as opções de parcelamento e formas de pagamento disponíveis para uma cotação aprovada. A forma `Invoice` (Fatura) só é retornada quando houver estipulante vinculado à cotação.\n",
        "operationId": "getPaymentSimulationPj",
        "tags": [
          "Cotação"
        ],
        "parameters": [
          {
            "name": "quote_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador da cotação."
          }
        ],
        "responses": {
          "200": {
            "description": "Condições de pagamento retornadas com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentSimulationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Cotação não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    },
    "/partners/rentalbond/v1/Proposals/pj": {
      "post": {
        "summary": "Realizar emissão de proposta/apólice",
        "description": "Transmite a proposta e emite a apólice para uma cotação PJ aprovada. O processamento é síncrono. A cotação deve estar com status `Approved`.\n",
        "operationId": "createProposalPj",
        "tags": [
          "Proposta PJ"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposalPjRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Proposta transmitida com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProposalPjCreatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos — status da cotação inelegível, parcelas inválidas ou forma de pagamento inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    },
    "/partners/rentalbond/v1/Proposals/pj/{quote_id}/document": {
      "get": {
        "summary": "Consultar documento da proposta",
        "description": "Retorna o documento da proposta/apólice PJ em formato PDF (Base64).",
        "operationId": "getProposalDocumentPj",
        "tags": [
          "Proposta PJ"
        ],
        "parameters": [
          {
            "name": "quote_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador da cotação associada à proposta."
          }
        ],
        "responses": {
          "200": {
            "description": "Documento retornado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PdfResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Proposta não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "clientId": {
        "type": "apiKey",
        "in": "header",
        "name": "client_id",
        "description": "Client ID da App"
      },
      "accessToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token de acesso"
      }
    },
    "parameters": {
      "personId": {
        "name": "x-person-id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "UUID do corretor autenticado."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "QuoteAddress": {
        "type": "object",
        "required": [
          "zipCode",
          "street",
          "number",
          "district",
          "city",
          "uf"
        ],
        "properties": {
          "zipCode": {
            "type": "string",
            "description": "CEP."
          },
          "street": {
            "type": "string",
            "description": "Logradouro."
          },
          "number": {
            "type": "string",
            "description": "Número."
          },
          "complement": {
            "type": "string",
            "description": "Complemento."
          },
          "district": {
            "type": "string",
            "description": "Bairro."
          },
          "city": {
            "type": "string",
            "description": "Cidade."
          },
          "uf": {
            "type": "string",
            "description": "Estado (UF)."
          }
        }
      },
      "QuoteParty": {
        "type": "object",
        "required": [
          "name",
          "document"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome."
          },
          "document": {
            "type": "string",
            "description": "CPF ou CNPJ (somente dígitos)."
          },
          "commissionPercentage": {
            "type": "number",
            "description": "Percentual de comissão (mínimo 5%). Comissão total entre participantes deve estar entre 5% e 40%."
          }
        }
      },
      "QuoteTenantItem": {
        "type": "object",
        "required": [
          "type",
          "name",
          "document"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Principal",
              "Solidary"
            ],
            "description": "Tipo do locatário."
          },
          "name": {
            "type": "string",
            "description": "Nome."
          },
          "document": {
            "type": "string",
            "description": "CPF ou CNPJ. O locatário Principal deve ser CNPJ; locatários Solidários podem ser PF ou PJ."
          },
          "email": {
            "type": "string",
            "description": "E-mail."
          },
          "phoneNumber": {
            "type": "string",
            "description": "Telefone."
          },
          "address": {
            "$ref": "#/components/schemas/QuoteAddress"
          }
        }
      },
      "QuoteInsuredItem": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do segurado."
          },
          "document": {
            "type": "string",
            "description": "CPF ou CNPJ."
          },
          "email": {
            "type": "string",
            "description": "E-mail."
          },
          "address": {
            "$ref": "#/components/schemas/QuoteAddress"
          }
        }
      },
      "QuoteCoverageRequest": {
        "type": "object",
        "required": [
          "type",
          "multiple",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "BasicRental",
              "Condominium",
              "Iptu",
              "Water",
              "Electricity",
              "Gas",
              "PromotionalFund",
              "AirConditioning",
              "PropertyDamage",
              "Painting",
              "FineForTermination"
            ],
            "description": "Tipo da cobertura. Valores possíveis:\n  * `BasicRental` (1) — Aluguel (obrigatória, exatamente 1 por cotação)\n  * `Condominium` (2) — Condomínio\n  * `Iptu` (3) — IPTU\n  * `Water` (4) — Água\n  * `Electricity` (5) — Luz\n  * `Gas` (6) — Gás\n  * `PromotionalFund` (7) — Fundo de Promoção (somente quando `isShoppingCenter = true`)\n  * `AirConditioning` (8) — Ar Condicionado (somente quando `isShoppingCenter = true`)\n  * `PropertyDamage` (9) — Danos ao Imóvel\n  * `Painting` (10) — Pintura Interna e Externa\n  * `FineForTermination` (11) — Multa por Rescisão Contratual\n"
          },
          "multiple": {
            "type": "integer",
            "description": "Múltiplo do aluguel."
          },
          "value": {
            "type": "number",
            "description": "Valor mensal do aluguel para a cobertura."
          }
        }
      },
      "QuoteCoverageResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "BasicRental",
              "Condominium",
              "Iptu",
              "Water",
              "Electricity",
              "Gas",
              "PromotionalFund",
              "AirConditioning",
              "PropertyDamage",
              "Painting",
              "FineForTermination"
            ],
            "description": "Tipo da cobertura (ver enum em `QuoteCoverageRequest.type`)."
          },
          "multiple": {
            "type": "integer",
            "description": "Múltiplo do aluguel."
          },
          "lmi": {
            "type": "number",
            "description": "Limite Máximo de Indenização."
          },
          "premium": {
            "type": "number",
            "description": "Prêmio da cobertura."
          },
          "value": {
            "type": "number",
            "description": "Valor do aluguel."
          }
        }
      },
      "QuotePaymentInfo": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Bill",
              "Invoice"
            ],
            "description": "Forma de pagamento."
          },
          "firstDueDate": {
            "type": "string",
            "format": "date-time",
            "description": "Data do primeiro vencimento (obrigatória para Boleto)."
          },
          "installments": {
            "type": "integer",
            "description": "Número de parcelas."
          }
        }
      },
      "QuoteRequest": {
        "type": "object",
        "required": [
          "dateInsuranceStart",
          "dateInsuranceEnd",
          "dateRentalStart",
          "dateRentalEnd",
          "broker",
          "tenants",
          "address",
          "coverages",
          "payment",
          "planType",
          "rentalType",
          "callbackUrl"
        ],
        "properties": {
          "dateInsuranceStart": {
            "type": "string",
            "format": "date-time",
            "description": "Início da vigência do seguro. Não pode ser anterior a hoje nem superior a hoje + 30 dias."
          },
          "dateInsuranceEnd": {
            "type": "string",
            "format": "date-time",
            "description": "Fim da vigência do seguro. Período máximo de 60 meses a contar do início de vigência."
          },
          "dateRentalStart": {
            "type": "string",
            "format": "date-time",
            "description": "Início do contrato de locação."
          },
          "dateRentalEnd": {
            "type": "string",
            "format": "date-time",
            "description": "Fim do contrato de locação."
          },
          "planType": {
            "type": "string",
            "enum": [
              "Traditional"
            ],
            "description": "Tipo de plano. Deve ser 'Traditional'."
          },
          "rentalType": {
            "type": "string",
            "enum": [
              "Residential",
              "Commercial"
            ],
            "description": "Tipo de imóvel."
          },
          "isShoppingCenter": {
            "type": "boolean",
            "description": "Indica se o imóvel está em shopping center."
          },
          "callbackUrl": {
            "type": "string",
            "description": "URL para receber o resultado da análise."
          },
          "policyOwner": {
            "allOf": [
