APP_NAME=NVS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_QUEUE_RETRY_AFTER=600
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=corretora
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=nvs_session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use MAIL_MAILER=resend somente no .env real do ambiente.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cadastro inicial do CEO deve permanecer desabilitado por padrao.
CEO_REGISTRATION_ENABLED=false
CEO_REGISTRATION_SECRET=
CEO_REGISTRATION_PATH=admin/setup/ceo

CORRETOR_INVITATION_EXPIRATION_HOURS=48
CORRETOR_INVITATION_RESEND_COOLDOWN_SECONDS=60

# Home publica e identidade visual sao configuracoes independentes das analises.
# Release do cliente: PUBLIC_INDEX_ENABLED=false, BRAND_PROFILE=client e
# INSURANCE_ANALYSIS_ENABLED=false.
PUBLIC_INDEX_ENABLED=false
BRAND_PROFILE=tcc

# Feature flags: integracoes externas permanecem desabilitadas por padrao.
INSURANCE_ANALYSIS_ENABLED=false
POTTENCIAL_ENABLED=false
TOO_ENABLED=false
PORTO_ENABLED=false
TOKIO_ENABLED=false
CPF_LOOKUP_ENABLED=false
LEADLOVERS_ENABLED=false

LEADLOVERS_API_URL=https://api.leadlovers.com
LEADLOVERS_TOKEN=
LEADLOVERS_MACHINE=
LEADLOVERS_SEQUENCE=
LEADLOVERS_SEQUENCE_LOCATARIO=
LEADLOVERS_STEP=1
LEADLOVERS_RATE_LIMIT_RETRY_SECONDS=60
LEADLOVERS_RATE_LIMIT_MAX_RETRY_SECONDS=900
LEADLOVERS_REQUESTS_PER_MINUTE=90
LEADLOVERS_RATE_LIMIT_WINDOW_SECONDS=60
LEADLOVERS_INITIAL_UPDATE_DELAY_SECONDS=60
LEADLOVERS_MACHINE_CONFIRMATION_DELAY_SECONDS=15
LEADLOVERS_TAG_CONFIRMATION_DELAY_SECONDS=15
LEADLOVERS_TAG_UNCERTAIN_RETRY_CHECKS=2
LEADLOVERS_TAG_MAX_POST_ATTEMPTS=2
LEADLOVERS_TAG_POSTING_STALE_SECONDS=60
LEADLOVERS_FIELD_CPF=
LEADLOVERS_FIELD_ESTADO_CIVIL=
LEADLOVERS_FIELD_CONJUGE_CPF=
LEADLOVERS_FIELD_VALOR_ALUGUEL=
LEADLOVERS_FIELD_VALOR_AGUA=
LEADLOVERS_FIELD_VALOR_LUZ=
LEADLOVERS_FIELD_VALOR_GAS=
LEADLOVERS_FIELD_VALOR_CONDOMINIO=
LEADLOVERS_FIELD_VALOR_IPTU=
LEADLOVERS_FIELD_OUTRAS_DESPESAS=

